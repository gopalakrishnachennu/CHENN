rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'gopalakrishnachennu@gmail.com';
    }

    function anonymous() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function ownsCandidate(candidateId) {
      let candidate = get(/databases/$(database)/documents/candidates/$(candidateId));
      return signedIn()
        && candidate.data.email == request.auth.token.email
        && candidate.data.portalEnabled == true
        && candidate.data.status != 'Archived';
    }

    match /candidates/{candidateId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.email == request.auth.token.email
      );
      allow write: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isAdmin() || ownsCandidate(resource.data.candidateId);
      allow write: if isAdmin();
    }

    match /jdProfiles/{profileId} {
      allow read, write: if isAdmin();
    }
    match /aiRequests/{requestId} {
      allow read, write: if isAdmin();
    }
    match /llmUsage/{requestId} {
      allow read, write: if isAdmin();
    }
    match /resumeCounters/{jobId} {
      allow read, write: if isAdmin();
    }
    match /catalogJobs/{jobId} {
      allow read: if isAdmin() || (
        signedIn() && exists(/databases/$(database)/documents/candidateCatalogAccess/$(request.auth.token.email)/jobs/$(jobId))
        && ownsCandidate(get(/databases/$(database)/documents/candidateCatalogAccess/$(request.auth.token.email)/jobs/$(jobId)).data.candidateId)
      );
      allow write: if isAdmin();
    }

    match /jobMatches/{matchId} {
      allow read: if isAdmin() || ownsCandidate(resource.data.candidateId);
      allow write: if isAdmin();
    }
    match /candidateCatalogAccess/{email}/jobs/{jobId} {
      allow read, write: if isAdmin();
    }

    match /resumes/{resumeId} {
      allow read: if isAdmin() || (
        ownsCandidate(resource.data.candidateId)
        && resource.data.candidateVisible == true
      );
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isAdmin() || ownsCandidate(resource.data.candidateId);
      allow write: if isAdmin();
    }

    match /files/{fileId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.kind == 'logo')
        || ownsCandidate(resource.data.candidateId);
      allow write: if isAdmin();
    }

    match /families/{familyId} {
      allow read: if signedIn() || anonymous();
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || (signedIn() && resource.data.active == true);
      allow write: if isAdmin();
    }

    match /prompts/{promptId} {
      allow read, write: if isAdmin();
      match /versions/{versionId} { allow read, create: if isAdmin(); allow update, delete: if false; }
    }

    match /evaluations/{evaluationId} {
      allow read, write: if isAdmin();
    }

    match /logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /onboardingInvites/{inviteId} {
      allow read: if isAdmin() || (anonymous() && resource.data.status == 'Open' && (!('expiresAtMs' in resource.data) || resource.data.expiresAtMs > request.time.toMillis()));
      allow write: if isAdmin();
    }

    match /onboardingSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if anonymous()
        && request.resource.data.status == 'Pending'
        && request.resource.data.inviteId is string
        && exists(/databases/$(database)/documents/onboardingInvites/$(request.resource.data.inviteId))
        && get(/databases/$(database)/documents/onboardingInvites/$(request.resource.data.inviteId)).data.status == 'Open'
        && (!('expiresAtMs' in get(/databases/$(database)/documents/onboardingInvites/$(request.resource.data.inviteId)).data) || get(/databases/$(database)/documents/onboardingInvites/$(request.resource.data.inviteId)).data.expiresAtMs > request.time.toMillis());
      allow update, delete: if isAdmin();
    }

    match /matchReviewSignals/{signalId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
